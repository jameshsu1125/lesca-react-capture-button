{
  "name": "lesca-react-capture-button",
  "private": false,
  "description": "get base64 image use local file.",
  "version": "4.1.2",
  "type": "module",
  "keywords": [
    "lesca"
  ],
  "files": [
    "lib"
  ],
  "main": "./lib/index.cjs",
  "module": "./lib/index.js",
  "types": "./lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "import": "./lib/index.js"
    }
  },
  "scripts": {
    "dev": "NODE_ENV=DEV vite --host",
    "build": "NODE_ENV=production tsc -b && vite build && tsc -p tsconfig.build.json",
    "lint": "eslint .",
    "preview": "vite preview",
    "rm": "rm -rf node_modules/ dist/ package-lock.json"
  },
  "dependencies": {
    "compressorjs": "^1.4.0",
    "lesca-user-agent": "^3.0.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "eslint": "^10.12.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.13.0",
    "path": "^0.12.7",
    "prettier": "^3.9.10",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.2",
    "vite": "^8.3.4",
    "vite-plugin-css-injected-by-js": "^5.0.2"
  }
}
